{
    "name": "Face Replacer",
    "version": "1.0",
    "manifest_version": 3,
    "description": "Face replacement extension using TensorFlow.js",

    "permissions": ["activeTab", "scripting"],

    "background": {
      "service_worker": "background.js"
    },

    "action": {
      "default_popup": "popup.html"
    },

    "web_accessible_resources": [
      {
        "resources": [
          "libs/tf.min.js",
          "libs/tf-backend-wasm.js",
          "libs/tf-backend-wasm.wasm",
          "libs/face-api.min.js",
          "models/*"
        ],
        "matches": ["<all_urls>"]
      }
    ],

    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": [
          "tf-loader.js",
          "content-script.js"
        ],
        "run_at": "document_end"
      }
    ],

    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
}
