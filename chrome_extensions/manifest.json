{
  "manifest_version": 3,
  "name": "Face Detection Extension",
  "version": "1.0",
  "description": "Detects faces in images and marks them with red squares",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Detect Faces",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "face-api.min.js",
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [{
    "resources": [
      "models/*",
      "icons/*"
    ],
    "matches": ["<all_urls>"]
  }]
} 